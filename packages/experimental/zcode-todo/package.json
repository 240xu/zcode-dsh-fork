{
  "name": "@deepseek-ai/dsh-zcode-todo",
  "description": "ZCode 3.10.2 TodoRead tool for the zcode agent preset: a read-only view over the shared todos projection owned by dsh-tool-todo.",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
